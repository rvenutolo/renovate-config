{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // This repo uses its own preset from the default branch, untagged, so it
  // always runs the current preset. Renovate's renovate-config manager skips
  // unpinned references, so nothing tries to bump this line.
  extends: ['local>rvenutolo/renovate-config'],
}
