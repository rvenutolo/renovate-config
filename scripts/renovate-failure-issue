#!/usr/bin/env bash

# @description File, update and close the issue that tracks a Renovate PR whose
#              CI failed or that is stuck open after the update window. One
#              issue per PR, labeled `dependencies` and
#              `renovate-failure`, found again through the hidden marker on the
#              first line of its body:
#
#                <!-- renovate-failure pr=<N> count=<K> -->
#
#              `open` runs after a CI run on a `renovate/*` branch fails. It
#              looks up the branch's PR. If that PR is no longer open, it files
#              nothing and instead closes the PR's failure issue as `close`
#              would: a run can finish after its PR closed, and if that PR's
#              close run never ran or ran too early, the issue would otherwise
#              stay open. Whichever run comes last leaves it closed. Otherwise
#              a first failure creates the issue; a repeat failure rewrites
#              the body of the existing one and bumps the count. It never
#              comments, because every comment emails the user and a broken PR
#              re-fails after each merge in the window.
#
#              `close` runs when a Renovate PR closes. It records the outcome
#              in the body and closes the issue as `completed` (merged) or
#              `not_planned` (closed unmerged), again without a comment. With
#              no matching open issue it does nothing, so a repeated or
#              re-queued run is harmless.
#
#              `sweep` runs on a schedule after the update window closes. It
#              files an issue, with `count=0` and a "stuck" title, for every
#              open Renovate PR that should have merged by then: a
#              `renovate/*` branch of this repository, not a draft, GitHub
#              auto-merge enabled, and opened at least SWEEP_MIN_AGE_HOURS
#              ago. A PR that already has a failure issue (`count` 1 or more)
#              is skipped; a repeat sweep rewrites the stuck issue silently,
#              and a later CI failure turns it into a failure issue. The sweep
#              then closes, as `close` would, every issue whose PR has closed,
#              duplicates included, and closes as `not_planned` every stuck
#              issue whose PR is open but no longer counts as stuck. An issue
#              whose PR cannot be found is left open.
#
#              `problems` runs on Sunday before the update window closes. It
#              reads Renovate's Dependency Dashboard (the open issue by
#              `renovate[bot]` titled "Dependency Dashboard") and files one
#              issue per repository listing the problems Renovate reports
#              there: the "Repository Problems" list, the lookup-failure
#              block, and the "Errored" branches. That issue's first line is
#
#                <!-- renovate-problems set=<fingerprint>[ resolved=1] -->
#
#              Branch names, PR titles and bodies, job names, job logs and the
#              Dashboard body are
#              untrusted: they reach jq only through --arg, --rawfile or stdin,
#              and reach gh only as request bodies on stdin, never as program
#              text or as part of a command line other than the URL-encoded
#              branch in the PR lookup.
# @arg $1 subcommand `open`, `close`, `sweep` or `problems`
# @env GITHUB_REPOSITORY `owner/repo`, every subcommand
# @env RUN_ID, RUN_URL, HEAD_BRANCH, RUN_CONCLUSION the failed run, for `open`;
#      RUN_CONCLUSION is one of `failure`, `timed_out`, `startup_failure`
# @env SWEEP_MIN_AGE_HOURS optional, for `sweep`: how many hours a PR must
#      have been open to count as stuck; default 12
# @env SWEEP_MERGEABLE_TRIES optional, for `sweep`: how many times to read a
#      PR's mergeable state while GitHub still reports it as unknown;
#      default 3
# @env SWEEP_RETRY_DELAY optional, for `sweep`: seconds between those reads;
#      default 2
# @env PROBLEMS_NOW optional, for `problems`: the time, as an ISO 8601 UTC
#      timestamp, at which to decide whether the run is inside the update
#      window; default the current time
# @env PR_NUMBER, PR_MERGED the closed PR, for `close`; PR_MERGED is `true` or
#      `false`
# @env LOG_TAIL_LINES optional, how many trailing lines of each failed job's
#      log to include, ANSI escape sequences stripped; default 150. The body
#      is shortened further when it would exceed GitHub's size limit
# @stderr a `[<script>] <message>` line per action taken or skipped, gh's own
#         error output, the usage line; the ERR trap's
#         `[<script>] ERROR: ...` report when a command fails
# @exitcode 0 the issue was created, updated or closed, or there was
#             deliberately nothing to do
# @exitcode 1 a GitHub API call failed
# @exitcode 2 a missing or unknown subcommand, or a missing or malformed
#             environment variable
# @exitcode * otherwise the status of a failing local command

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

readonly FAILURE_LABEL='renovate-failure'
readonly DEPENDENCIES_LABEL='dependencies'
# GitHub rejects an issue body over 65,536 characters; the margin keeps a later
# `close`, which appends one outcome line, under that limit too.
readonly BODY_LIMIT=65000
# GitHub rejects an issue title over 256 characters.
readonly TITLE_LIMIT=256
readonly TRUNCATION_NOTE="_Log output truncated to fit GitHub's issue size limit._"
readonly PROBLEMS_TRUNCATION_NOTE="_Problem list truncated to fit GitHub's issue size limit._"
readonly PROBLEMS_TITLE='Renovate reports problems in this repository'
readonly PROBLEMS_WHAT_TO_DO='Fix what Renovate reports, or adjust the Renovate config so it no longer reports it. This issue closes by itself once a Renovate run inside the Saturday 6pm to Sunday 6pm window (New York time) reports no problems. Closing it by hand silences these exact problems until they change.'
# The backticks are Markdown code spans, not command substitutions.
# shellcheck disable=SC2016
readonly HOW_TO_FIX='Fix the problem on `main`, then tick the rebase checkbox in the PR; a manual rebase request overrides the schedule. Alternatively, push the fix to the Renovate branch: Renovate stops rebasing a branch with foreign commits, but GitHub auto-merge stays armed, so once CI is green the PR merges by itself as long as it is up to date with `main`.'

# The backticks are Markdown code spans, not command substitutions.
# shellcheck disable=SC2016
readonly HOW_TO_UNSTICK='Find out why the PR did not merge: a failing or pending check, a merge conflict, or a branch behind `main` that no Renovate run rebased during the window. Tick the rebase checkbox in the PR to have Renovate rebase it now; a manual rebase request overrides the schedule. If the PR cannot merge as it is, fix the problem on `main` or push the fix to the Renovate branch, and GitHub auto-merge merges it once CI is green and the branch is up to date.'
# jq: whether an open PR counts as stuck. head.repo is null when the head
# repository was deleted, which compares unequal to $repo. The $names are jq's.
# shellcheck disable=SC2016
readonly IS_STUCK='def is_stuck($repo; $cutoff):
  ((.head.ref // "") | startswith("renovate/"))
  and .head.repo.full_name == $repo
  and .draft == false
  and .auto_merge != null
  and ((.created_at | fromdateiso8601) <= $cutoff);'

WORK_DIR=''

# @description Log one line to stderr.
# @arg $1 message the text to log
# @stderr the `[<script>] <message>` line
function log() {
  printf '[%s] %s\n' "${0##*/}" "$1" >&2
}

# @description Report a usage problem and exit 2.
# @arg $1 message what is wrong
# @stderr the message and the usage line
# @exitcode 2 always
function usage_error() {
  log "$1"
  printf 'usage: %s open|close|sweep|problems (configured through the environment)\n' "${0##*/}" >&2
  exit 2
}

# @description Report a failed API call and exit 1. Inside a command
#              substitution this exits only the subshell, and errexit then
#              carries the 1 out of the caller.
# @arg $1 message what failed
# @exitcode 1 always
function api_error() {
  log "$1"
  exit 1
}

# @description Fail with exit 2 unless every named variable is set and
#              non-empty.
# @arg $@ names the environment variable names
# @exitcode 2 a variable is missing
function require_env() {
  local name
  for name in "$@"; do
    if [[ -z "${!name:-}" ]]; then
      usage_error "missing required env: ${name}"
    fi
  done
}

# @description Fail with exit 2 unless a variable's value matches a pattern.
# @arg $1 name the variable name
# @arg $2 regex the extended regex the whole value must match
# @arg $3 expected a description of the valid values, for the message
# @exitcode 2 the value does not match
function require_format() {
  local -r name="$1" regex="$2" expected="$3"
  if [[ ! "${!name}" =~ ${regex} ]]; then
    usage_error "invalid ${name}: expected ${expected}"
  fi
}

# @description Run `gh api`, turning any failure into exit 1.
# @arg $@ args the `gh api` arguments
# @stdout the response
# @exitcode 1 the call failed
function gh_api() {
  gh api "$@" || api_error "gh api ${*} failed"
}

# @description Print the newest PR whose head is HEAD_BRANCH in this
#              repository, open or not, or nothing when there is none.
# @stdout the PR as compact JSON, or nothing
function find_pr() {
  local -r owner="${GITHUB_REPOSITORY%%/*}"
  local branch
  branch="$(jq --null-input --raw-output --arg branch "${HEAD_BRANCH}" '$branch | @uri')"
  gh_api "repos/${GITHUB_REPOSITORY}/pulls?head=${owner}:${branch}&state=all" \
    | jq --compact-output 'max_by(.number) // empty'
}

# @description Print the latest attempt's jobs of run RUN_ID: how many started,
#              and the ones that failed or timed out, in API order.
# @stdout compact JSON `{started: <n>, failed: [{id, name, conclusion}]}`
function failed_jobs() {
  gh_api --paginate "repos/${GITHUB_REPOSITORY}/actions/runs/${RUN_ID}/jobs?filter=latest" \
    | jq --slurp --compact-output '[.[].jobs[]] | {
        started: length,
        failed: [.[] | select(.conclusion == "failure" or .conclusion == "timed_out")
                     | {id, name, conclusion}]
      }'
}

# @description Print the last LOG_TAIL_LINES lines of one job's log, without
#              ANSI escape sequences: tools color their CI output, and the
#              codes would show as noise in the issue.
# @arg $1 id the job id
# @stdout the log tail
# @exitcode 1 the log could not be fetched
function job_log_tail() {
  local -r id="$1"
  gh api "repos/${GITHUB_REPOSITORY}/actions/jobs/${id}/logs" \
    | tail --lines="${LOG_TAIL_LINES}" \
    | LC_ALL=C sed --regexp-extended 's#\x1b\[[0-?]*[ -/]*[@-~]##g'
}

# @description Print the updates table from a Renovate PR body: the text after
#              the `This PR contains the following updates:` line, up to the
#              next `---` line, trimmed. Nothing when the PR body has no such
#              line.
# @stdin the PR as JSON
# @stdout the table
function pr_updates_table() {
  jq --raw-output '
    (.body // "") | gsub("\r"; "") | split("\n") as $lines
    | ($lines | map(startswith("This PR contains the following updates:")) | index(true)) as $start
    | if $start == null then "" else
        $lines[$start + 1:] as $rest
        | ($rest | map(test("^---\\s*$")) | index(true)) as $end
        | (if $end == null then $rest else $rest[:$end] end)
        | join("\n") | sub("^\\s+"; "") | sub("\\s+$"; "")
      end'
}

# @description Create a label unless it exists. A 422 on create means a
#              concurrent run created it first, which is fine.
# @arg $1 name the label name
# @arg $2 color the label color, hex without `#`
# @arg $3 description the label description
# @exitcode 1 the lookup failed other than with a 404, or the create failed
#             other than with a 422
function ensure_label() {
  local -r name="$1" color="$2" description="$3"
  local err
  # stderr is captured to tell a 404 from other failures; stdout, gh's echo of
  # the error body, is discarded.
  # shellcheck disable=SC2069
  if err="$(gh api "repos/${GITHUB_REPOSITORY}/labels/${name}" 2>&1 > /dev/null)"; then
    return 0
  fi
  if [[ "${err}" != *'(HTTP 404)'* ]]; then
    printf '%s\n' "${err}" >&2
    api_error "looking up label ${name} failed"
  fi
  # shellcheck disable=SC2069
  if err="$(jq --null-input --arg name "${name}" --arg color "${color}" --arg description "${description}" \
    '{name: $name, color: $color, description: $description}' \
    | gh api --method POST "repos/${GITHUB_REPOSITORY}/labels" --input - 2>&1 > /dev/null)"; then
    log "created label ${name}"
    return 0
  fi
  if [[ "${err}" == *'(HTTP 422)'* ]]; then
    log "label ${name} already exists"
    return 0
  fi
  printf '%s\n' "${err}" >&2
  api_error "creating label ${name} failed"
}

# @description Print every open, unfinished failure issue: those labeled
#              FAILURE_LABEL whose body starts with the marker line. The
#              marker may carry the optional fields ` artifact=<sha>` and then
#              ` done=1` after the count; an issue marked `done=1` is finished
#              and left out.
# @stdout compact JSON array of `{number, pr, count, body}`
function open_issues() {
  gh_api --paginate "repos/${GITHUB_REPOSITORY}/issues?labels=${FAILURE_LABEL}&state=open&per_page=100" \
    | jq --slurp --compact-output '
      [ add // [] | .[] | select(.pull_request == null)
        | ((.body // "") | (split("\n")[0] // "") | sub("\r$"; "")
           | capture("^<!-- renovate-failure pr=(?<pr>[0-9]+) count=(?<count>[0-9]+)(?: artifact=(?<artifact>[0-9a-f]{40}))?(?<done> done=1)? -->$")) as $m
        | select($m.done == null)
        | {number, pr: ($m.pr | tonumber), count: ($m.count | tonumber), body}
      ]'
}

# @description Print the open, unfinished failure issue whose marker names the
#              given PR, the oldest one if there are several, or nothing.
# @arg $1 pr the PR number
# @stdout compact JSON `{number, count, body}`, or nothing
function find_issue() {
  local -r pr="$1"
  open_issues | jq --compact-output --argjson pr "${pr}" '
    map(select(.pr == $pr)) | min_by(.number) // empty | {number, count, body}'
}

# @description Print an issue title for a PR, cut to TITLE_LIMIT.
# @arg $1 what what happened to the PR, e.g. `failed CI`
# @stdin the PR as JSON
# @stdout the title
function issue_title() {
  local -r what="$1"
  jq --raw-output --arg what "${what}" --argjson limit "${TITLE_LIMIT}" '
    "Renovate PR #\(.number) \($what): \(.title)"
    | if length > $limit then .[:$limit - 1] + "…" else . end'
}

# @description Create the PR's issue with both labels, or rewrite the title
#              and body of the existing one.
# @arg $1 existing the existing issue as `{number, ...}` JSON, or empty
# @arg $2 title the issue title
# @arg $3 body_file the file holding the issue body
# @stdout the issue number on update, or nothing on create
function upsert_issue() {
  local -r existing="$1" title="$2" body_file="$3"
  if [[ -n "${existing}" ]]; then
    local issue_number
    issue_number="$(jq --raw-output '.number' <<< "${existing}")"
    jq --null-input --arg title "${title}" --rawfile body "${body_file}" \
      '{title: $title, body: $body}' \
      | gh_api --method PATCH "repos/${GITHUB_REPOSITORY}/issues/${issue_number}" --input - > /dev/null
    printf '%s\n' "${issue_number}"
    return 0
  fi
  ensure_label "${DEPENDENCIES_LABEL}" '0366d6' 'Dependency updates'
  ensure_label "${FAILURE_LABEL}" 'd73a4a' 'A Renovate PR whose CI failed'
  jq --null-input --arg title "${title}" --rawfile body "${body_file}" \
    --arg dependencies "${DEPENDENCIES_LABEL}" --arg failure "${FAILURE_LABEL}" \
    '{title: $title, body: $body, labels: [$dependencies, $failure]}' \
    | gh_api --method POST "repos/${GITHUB_REPOSITORY}/issues" --input - > /dev/null
}

# @description Render the issue body, shortening the log tails, longest first,
#              when it would exceed BODY_LIMIT, and noting the truncation at
#              the end.
# @stdin JSON `{pr: {number, html_url}, count, updates, started,
#        run: {url, conclusion, failed_at}, jobs: [{name, conclusion, log}]}`
# @stdout the body
function render_body() {
  jq --raw-output --argjson limit "${BODY_LIMIT}" --arg note "${TRUNCATION_NOTE}" \
    --arg how_to_fix "${HOW_TO_FIX}" '
    def fence: ([scan("`+") | length] | max // 0) as $run | "`" * ([3, $run + 1] | max);
    def job_block:
      (.log | fence) as $f
      | "<details>\n<summary>\(.name | @html) (\(.conclusion))</summary>\n\n"
        + "\($f)text\n\(.log | sub("\n$"; ""))\n\($f)\n\n</details>";
    def render:
      [ "<!-- renovate-failure pr=\(.pr.number) count=\(.count) -->",
        "CI failed on Renovate PR #\(.pr.number): \(.count) failed run\(if .count == 1 then "" else "s" end) so far.",
        "",
        "**PR:** \(.pr.html_url)",
        "",
        "## Updates in this PR",
        "",
        (if .updates == "" then "_The PR body does not list its updates; see the PR._" else .updates end),
        "",
        "## Latest failed run",
        "",
        "- **Run:** \(.run.url)",
        "- **Conclusion:** `\(.run.conclusion)`",
        "- **Failure count:** \(.count)",
        "- **Last failed:** \(.run.failed_at)",
        (if (.jobs | length) > 0 then "- **Failed jobs:** \(.jobs | map(.name | @html) | join(", "))" else empty end),
        "",
        (if .started == 0 then
           "_No jobs started: the run failed before any job ran, for example on an invalid workflow file or an action the repository does not allow._"
         elif (.jobs | length) == 0 then
           "_No job in this run failed or timed out; see the run for details._"
         else .jobs | map(job_block) | join("\n\n") end),
        "",
        "## How to land a fix",
        "",
        $how_to_fix
      ] | join("\n") + "\n";
    # Cut the longest logs down to the next-longest, or by their share of the
    # overflow, until the body fits; each round shortens the longest log, so
    # this terminates. A cut drops the partial line it leaves at the start.
    def shrink($budget):
      (render | length) as $len
      | ([.jobs[].log | length] | max // 0) as $top
      | if $len <= $budget or $top == 0 then . else
          ([.jobs[].log | length | select(. < $top)] | max // 0) as $next
          | ([.jobs[] | select((.log | length) == $top)] | length) as $k
          | ([$next, $top - ((($len - $budget) + $k - 1) / $k | floor)] | max) as $keep
          | .jobs |= map(
              if (.log | length) == $top then
                .log |= (.[length - $keep:] | if test("\n") then sub("^[^\n]*\n"; "") else . end)
              else . end)
          | shrink($budget)
        end;
    render as $full
    | if ($full | length) <= $limit then $full else
        ($limit - ($note | length) - 2) as $budget
        | (shrink($budget) | render) as $short
        | (if ($short | length) <= $budget then $short else $short[:$budget - 1] + "\n" end)
          + "\n" + $note + "\n"
      end'
}

# @description Handle a failed CI run: create or update the PR's failure issue,
#              or close it when the PR is no longer open.
# @exitcode 0 the issue was written or closed, or there was nothing to do
function open_cmd() {
  require_env GITHUB_REPOSITORY RUN_ID RUN_URL HEAD_BRANCH RUN_CONCLUSION
  require_format GITHUB_REPOSITORY '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' 'owner/repo'
  require_format RUN_ID '^[0-9]+$' 'a number'
  require_format RUN_CONCLUSION '^(failure|timed_out|startup_failure)$' 'failure, timed_out or startup_failure'
  LOG_TAIL_LINES="${LOG_TAIL_LINES:-150}"
  require_format LOG_TAIL_LINES '^[1-9][0-9]*$' 'a positive number'

  find_pr > "${WORK_DIR}/pr.json"
  if [[ ! -s "${WORK_DIR}/pr.json" ]]; then
    log 'no PR for this branch; nothing to do'
    return 0
  fi
  local pr_number pr_state
  pr_number="$(jq --raw-output '.number' "${WORK_DIR}/pr.json")"
  pr_state="$(jq --raw-output '.state' "${WORK_DIR}/pr.json")"
  if [[ "${pr_state}" != 'open' ]]; then
    log "PR #${pr_number} is ${pr_state}; closing its failure issue instead"
    close_issue "${pr_number}" "$(jq --raw-output '.merged_at != null' "${WORK_DIR}/pr.json")"
    return 0
  fi

  failed_jobs > "${WORK_DIR}/jobs.json"
  local -i job_count i
  job_count="$(jq '.failed | length' "${WORK_DIR}/jobs.json")"
  mkdir "${WORK_DIR}/jobs"
  for ((i = 0; i < job_count; i++)); do
    local job_file
    job_file="${WORK_DIR}/jobs/$(printf '%04d' "${i}")"
    jq --compact-output --argjson i "${i}" '.failed[$i]' "${WORK_DIR}/jobs.json" > "${job_file}.json"
    # A missing log degrades one section rather than losing the whole issue.
    if ! job_log_tail "$(jq --raw-output '.id' "${job_file}.json")" > "${job_file}.log"; then
      log "could not fetch the log of job $(jq --raw-output '.id' "${job_file}.json")"
      printf '(The log could not be fetched; see the run.)\n' > "${job_file}.log"
    fi
    jq --compact-output --rawfile log "${job_file}.log" '{name, conclusion, log: $log}' \
      "${job_file}.json" > "${job_file}.job.json"
  done

  local existing count=1
  existing="$(find_issue "${pr_number}")"
  if [[ -n "${existing}" ]]; then
    count="$(jq '.count + 1' <<< "${existing}")"
  fi

  pr_updates_table < "${WORK_DIR}/pr.json" > "${WORK_DIR}/updates.md"
  local failed_at
  failed_at="$(date --utc '+%Y-%m-%dT%H:%M:%SZ')"
  shopt -s nullglob
  local -a job_docs=("${WORK_DIR}/jobs/"*.job.json)
  shopt -u nullglob
  { cat "${WORK_DIR}/pr.json" "${job_docs[@]}"; } \
    | jq --null-input --compact-output \
      --slurpfile started "${WORK_DIR}/jobs.json" --rawfile updates "${WORK_DIR}/updates.md" \
      --argjson count "${count}" --arg run_url "${RUN_URL}" \
      --arg conclusion "${RUN_CONCLUSION}" --arg failed_at "${failed_at}" '
      [inputs] as $docs
      | { pr: ($docs[0] | {number, html_url}), count: $count,
          updates: ($updates | sub("\n$"; "")), started: $started[0].started,
          run: {url: $run_url, conclusion: $conclusion, failed_at: $failed_at},
          jobs: $docs[1:] }' \
    | render_body > "${WORK_DIR}/body.md"

  local title updated
  title="$(issue_title 'failed CI' < "${WORK_DIR}/pr.json")"
  updated="$(upsert_issue "${existing}" "${title}" "${WORK_DIR}/body.md")"
  if [[ -n "${updated}" ]]; then
    log "updated issue #${updated} for PR #${pr_number} (failure ${count})"
  else
    log "created failure issue for PR #${pr_number}"
  fi
}

# @description Print the CI state of a commit: `failing` if any check run or
#              commit status failed, else `pending` if any is still running,
#              else `none` if there are none, else `passing`.
# @arg $1 sha the commit SHA
# @stdout the state
function head_ci_state() {
  local -r sha="$1"
  gh_api "repos/${GITHUB_REPOSITORY}/commits/${sha}/status" > "${WORK_DIR}/status.json"
  gh_api --paginate "repos/${GITHUB_REPOSITORY}/commits/${sha}/check-runs?per_page=100" \
    | jq --slurp --compact-output '[.[].check_runs[]]' > "${WORK_DIR}/check-runs.json"
  jq --raw-output --null-input --slurpfile status "${WORK_DIR}/status.json" \
    --slurpfile runs "${WORK_DIR}/check-runs.json" '
    $status[0] as $s | $runs[0] as $r
    | if ($r | any(.conclusion as $c
            | ["failure", "timed_out", "cancelled", "action_required", "startup_failure"]
            | index($c)))
         or ($s.state == "failure" or $s.state == "error") then "failing"
      elif ($r | any(.status != "completed"))
         or ($s.state == "pending" and $s.total_count > 0) then "pending"
      elif ($r | length) == 0 and $s.total_count == 0 then "none"
      else "passing" end'
}

# @description Print a PR's mergeable state. GitHub computes it lazily and
#              reports null or `unknown` until it has, so it is read up to
#              SWEEP_MERGEABLE_TRIES times.
# @arg $1 number the PR number
# @stdout the state, or `unknown` if it never settled
function pr_mergeable_state() {
  local -r number="$1"
  local state='unknown'
  local -i try
  for ((try = 1; try <= SWEEP_MERGEABLE_TRIES; try++)); do
    state="$(gh_api "repos/${GITHUB_REPOSITORY}/pulls/${number}" \
      | jq --raw-output '.mergeable_state // "unknown"')"
    if [[ "${state}" != 'unknown' ]]; then
      break
    fi
    if ((try < SWEEP_MERGEABLE_TRIES)); then
      sleep "${SWEEP_RETRY_DELAY}"
    fi
  done
  printf '%s\n' "${state}"
}

# @description Print whether the PR's author, Renovate, posted its artifact
#              update problem comment on the PR. A comment by anyone else
#              with the same heading does not count.
# @arg $1 number the PR number
# @arg $2 author the PR author's login
# @stdout `true` or `false`
# @exitcode 1 the comments could not be read
function artifact_problem_reported() {
  local -r number="$1" author="$2"
  gh_api --paginate "repos/${GITHUB_REPOSITORY}/issues/${number}/comments?per_page=100" \
    > "${WORK_DIR}/comments.json"
  jq --slurp --arg author "${author}" '
      [add // [] | .[] | select(.user.login == $author
        and ((.body // "") | startswith("### ⚠️ Artifact update problem\n\n")))]
      | length > 0' "${WORK_DIR}/comments.json"
}

# @description Render a stuck issue's body.
# @stdin JSON `{pr: {number, html_url, created_at}, updates, swept_at, ci,
#        mergeable_state, artifact_problem}`
# @stdout the body
function render_stuck_body() {
  jq --raw-output --arg how_to_unstick "${HOW_TO_UNSTICK}" '
    [ "<!-- renovate-failure pr=\(.pr.number) count=0 -->",
      "Renovate PR #\(.pr.number) is still open after the update window, with GitHub auto-merge enabled.",
      "",
      "**PR:** \(.pr.html_url)",
      "",
      "## Updates in this PR",
      "",
      (if .updates == "" then "_The PR body does not list its updates; see the PR._" else .updates end),
      "",
      "## Current state",
      "",
      "- **Open since:** \(.pr.created_at)",
      "- **Swept at:** \(.swept_at)",
      "- **CI on the head commit:** \(.ci)",
      "- **Mergeable state:** `\(.mergeable_state)`",
      "- **Auto-merge:** enabled",
      "- **Artifact update problem reported by Renovate:** \(if .artifact_problem then "yes" else "no" end)",
      "",
      "## How to unstick it",
      "",
      $how_to_unstick
    ] | join("\n") + "\n"'
}

# @description File or rewrite the stuck issue for one PR, unless the PR
#              already has a failure issue.
# @arg $1 pr_file the file holding the PR as the pulls list returns it
function write_stuck_issue() {
  local -r pr_file="$1"
  local pr_number
  pr_number="$(jq --raw-output '.number' "${pr_file}")"
  local sha author ci mergeable artifact_problem swept_at
  sha="$(jq --raw-output '.head.sha' "${pr_file}")"
  author="$(jq --raw-output '.user.login' "${pr_file}")"
  ci="$(head_ci_state "${sha}")"
  mergeable="$(pr_mergeable_state "${pr_number}")"
  artifact_problem="$(artifact_problem_reported "${pr_number}" "${author}")"
  swept_at="$(date --utc '+%Y-%m-%dT%H:%M:%SZ')"
  pr_updates_table < "${pr_file}" > "${WORK_DIR}/updates.md"
  jq --compact-output --rawfile updates "${WORK_DIR}/updates.md" --arg swept_at "${swept_at}" \
    --arg ci "${ci}" --arg mergeable "${mergeable}" --argjson artifact_problem "${artifact_problem}" '
    {pr: {number, html_url, created_at}, updates: ($updates | sub("\n$"; "")),
     swept_at: $swept_at, ci: $ci, mergeable_state: $mergeable,
     artifact_problem: $artifact_problem}' "${pr_file}" \
    | render_stuck_body > "${WORK_DIR}/body.md"

  # Looked up last, right before the write, to narrow the race with an open
  # run filing a failure issue for the same PR.
  local existing
  existing="$(find_issue "${pr_number}")"
  if [[ -n "${existing}" ]] && (($(jq '.count' <<< "${existing}") >= 1)); then
    log "PR #${pr_number} already has a failure issue; skipping"
    return 0
  fi
  local title updated
  title="$(issue_title 'is stuck' < "${pr_file}")"
  updated="$(upsert_issue "${existing}" "${title}" "${WORK_DIR}/body.md")"
  if [[ -n "${updated}" ]]; then
    log "updated stuck issue #${updated} for PR #${pr_number}"
  else
    log "created stuck issue for PR #${pr_number}"
  fi
}

# @description Print every issue in this repository, open or closed. One
#              listing serves both the Dashboard lookup and the problems issue
#              lookup; both filter it themselves.
# @stdout compact JSON array of issues
function issues_all() {
  gh_api --paginate "repos/${GITHUB_REPOSITORY}/issues?state=all&per_page=100" > "${WORK_DIR}/issues-all.raw"
  jq --slurp --compact-output 'add // []' "${WORK_DIR}/issues-all.raw"
}

# @description Print Renovate's Dependency Dashboard: the oldest open issue,
#              not a pull request, authored by `renovate[bot]` and titled
#              `Dependency Dashboard`.
# @stdin the issues listing from issues_all
# @stdout compact JSON `{number, html_url, body}`, or nothing
function find_dashboard() {
  jq --compact-output '
    map(select(.state == "open" and .pull_request == null
      and .user.login == "renovate[bot]" and .title == "Dependency Dashboard"))
    | min_by(.number) // empty | {number, html_url, body: (.body // "")}'
}

# @description Print the problems a Dependency Dashboard body reports, in
#              the order they appear: the list items under "## Repository
#              Problems", every line of the quote block that names lookup
#              failures, and the list items under "## Errored". Lines lose
#              carriage returns, trailing whitespace and HTML comments.
# @stdin the Dashboard body
# @stdout the problem lines
function dashboard_problems() {
  awk '
    function flush() {
      if (quote ~ /Renovate failed to look up the following dependencies/) {
        printf "%s", quote
      }
      quote = ""
    }
    {
      sub(/\r$/, "")
      gsub(/<!--[^>]*-->/, "")
      sub(/[ \t]+$/, "")
    }
    /^>/ { quote = quote $0 "\n"; next }
    { flush() }
    /^## / { section = $0; listed = 0; next }
    /^---$/ { section = ""; next }
    section == "## Repository Problems" {
      if ($0 ~ /^ - /) { print; listed = 1 }
      else if ($0 != "" && listed) { section = "" }
      next
    }
    section == "## Errored" && /^ - / { print }
    END { flush() }'
}

# @description Print the fingerprint of a problem set: the first 16 hex
#              characters of the SHA-256 of its lines, sorted and deduplicated,
#              so the order Renovate lists them in does not matter.
# @stdin the problem lines
# @stdout the fingerprint
function problems_fingerprint() {
  LC_ALL=C sort --unique | sha256sum | cut --characters=1-16
}

# @description Print the Mend log link from a Dashboard body, if it has one
#              on developer.mend.io; a link to any other host is dropped.
# @stdin the Dashboard body
# @stdout the URL, or nothing
function mend_log_url() {
  jq --raw-input --slurp --raw-output '
    [match("https://developer\\.mend\\.io/[^ )\\s]*"; "g").string][0] // empty'
}

# @description Render the problems issue body. The problem lines go inside a
#              code fence longer than any backtick run they contain, so
#              nothing in them renders as a mention or link, and are cut to
#              keep the body under BODY_LIMIT.
# @stdin JSON `{fingerprint, problems, dashboard_url, mend_url}`
# @stdout the body
function render_problems_body() {
  jq --raw-output --argjson limit "${BODY_LIMIT}" --arg note "${PROBLEMS_TRUNCATION_NOTE}" \
    --arg title "${PROBLEMS_TITLE}" --arg what_to_do "${PROBLEMS_WHAT_TO_DO}" '
    def fence: ([scan("`+") | length] | max // 0) as $run | "`" * ([3, $run + 1] | max);
    ($limit - 2000) as $budget
    | (.problems | sub("\n$"; "")) as $text
    | (if ($text | length) > $budget then [($text[:$budget] | sub("\n[^\n]*$"; "")), true]
       else [$text, false] end) as [$shown, $cut]
    | ($shown | fence) as $f
    | [ "<!-- renovate-problems set=\(.fingerprint) -->",
        "Renovate reports problems on its Dependency Dashboard that no pull request will show.",
        "",
        "**Dependency Dashboard:** \(.dashboard_url)",
        (if .mend_url != "" then "**Renovate logs:** \(.mend_url)" else empty end),
        "",
        "## Problems",
        "",
        "\($f)text",
        $shown,
        $f,
        (if $cut then "", $note else empty end),
        "",
        "## What to do",
        "",
        $what_to_do
      ] | join("\n") + "\n"'
}

# @description Mirror the Dependency Dashboard's problems into this
#              repository's problems issue.
# @exitcode 0 the issue was written, or there was nothing to do
function problems_cmd() {
  require_env GITHUB_REPOSITORY
  require_format GITHUB_REPOSITORY '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' 'owner/repo'
  if [[ -n "${PROBLEMS_NOW:-}" ]]; then
    require_format PROBLEMS_NOW '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' 'an ISO 8601 UTC timestamp'
  fi

  issues_all > "${WORK_DIR}/issues-all.json"
  find_dashboard < "${WORK_DIR}/issues-all.json" > "${WORK_DIR}/dashboard.json"
  if [[ ! -s "${WORK_DIR}/dashboard.json" ]]; then
    log 'no Dependency Dashboard; nothing to do'
    return 0
  fi
  jq --raw-output '.body' "${WORK_DIR}/dashboard.json" > "${WORK_DIR}/dashboard.md"
  dashboard_problems < "${WORK_DIR}/dashboard.md" > "${WORK_DIR}/problems.txt"
  if [[ ! -s "${WORK_DIR}/problems.txt" ]]; then
    log 'the Dependency Dashboard reports no problems'
    return 0
  fi

  local fingerprint mend_url
  fingerprint="$(problems_fingerprint < "${WORK_DIR}/problems.txt")"
  mend_url="$(mend_log_url < "${WORK_DIR}/dashboard.md")"
  jq --null-input --arg fingerprint "${fingerprint}" --rawfile problems "${WORK_DIR}/problems.txt" \
    --arg mend_url "${mend_url}" --slurpfile dashboard "${WORK_DIR}/dashboard.json" '
    {fingerprint: $fingerprint, problems: $problems, mend_url: $mend_url,
     dashboard_url: $dashboard[0].html_url}' \
    | render_problems_body > "${WORK_DIR}/problems-body.md"
  upsert_issue '' "${PROBLEMS_TITLE}" "${WORK_DIR}/problems-body.md" > /dev/null
  log "created problems issue (set ${fingerprint})"
}

# @description Print every open PR in this repository.
# @stdout compact JSON array of PRs
function open_prs() {
  gh_api --paginate "repos/${GITHUB_REPOSITORY}/pulls?state=open&per_page=100" \
    | jq --slurp --compact-output 'add // []'
}

# @description After the update window: file or refresh an issue for every
#              stuck Renovate PR, then close the issues that no longer apply:
#              every issue whose PR has closed, as `close` would, which covers
#              a missed `close` run and duplicates alike; and every stuck
#              issue whose PR is open but no longer counts as stuck. A failure
#              issue on an open PR is left to `open` and `close`.
# @exitcode 0 every issue was written or closed, or there was nothing to do
function sweep_cmd() {
  require_env GITHUB_REPOSITORY
  require_format GITHUB_REPOSITORY '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' 'owner/repo'
  SWEEP_MIN_AGE_HOURS="${SWEEP_MIN_AGE_HOURS:-12}"
  require_format SWEEP_MIN_AGE_HOURS '^[0-9]+$' 'a whole number of hours'
  SWEEP_MERGEABLE_TRIES="${SWEEP_MERGEABLE_TRIES:-3}"
  require_format SWEEP_MERGEABLE_TRIES '^[1-9][0-9]*$' 'a positive number'
  SWEEP_RETRY_DELAY="${SWEEP_RETRY_DELAY:-2}"
  require_format SWEEP_RETRY_DELAY '^[0-9]+$' 'a whole number of seconds'

  local -i cutoff
  cutoff=$(($(date --utc '+%s') - SWEEP_MIN_AGE_HOURS * 3600))
  open_prs > "${WORK_DIR}/prs.json"
  mkdir "${WORK_DIR}/stuck"
  jq --raw-output --arg repo "${GITHUB_REPOSITORY}" --argjson cutoff "${cutoff}" \
    "${IS_STUCK}"' .[] | select(is_stuck($repo; $cutoff)) | .number' "${WORK_DIR}/prs.json" \
    > "${WORK_DIR}/stuck.txt"
  local -a numbers
  mapfile -t numbers < "${WORK_DIR}/stuck.txt"
  local number
  for number in "${numbers[@]}"; do
    jq --compact-output --argjson n "${number}" '.[] | select(.number == $n)' \
      "${WORK_DIR}/prs.json" > "${WORK_DIR}/stuck/${number}.json"
    write_stuck_issue "${WORK_DIR}/stuck/${number}.json"
  done

  open_issues > "${WORK_DIR}/issues.json"
  jq --compact-output --slurpfile prs "${WORK_DIR}/prs.json" --rawfile stuck "${WORK_DIR}/stuck.txt" '
    ($prs[0] | map(.number)) as $open
    | ($stuck | split("\n") | map(select(. != "") | tonumber)) as $stuck
    | .[] | .pr as $p
    | if any($open[]; . == $p) | not then {issue: ., pr: $p, why: "closed"}
      elif .count == 0 and (any($stuck[]; . == $p) | not) then {issue: ., pr: $p, why: "not-stuck"}
      else empty end' "${WORK_DIR}/issues.json" > "${WORK_DIR}/stale.jsonl"
  local -a stale
  mapfile -t stale < "${WORK_DIR}/stale.jsonl"
  local entry issue pr why
  for entry in "${stale[@]}"; do
    issue="$(jq --compact-output '.issue' <<< "${entry}")"
    pr="$(jq --raw-output '.pr' <<< "${entry}")"
    why="$(jq --raw-output '.why' <<< "${entry}")"
    if [[ "${why}" == 'not-stuck' ]]; then
      finish_issue "${issue}" "${pr}" 'no longer stuck: auto-merge is off or the PR is a draft' 'not_planned'
      continue
    fi
    # A PR that cannot be found would otherwise fail every later sweep and
    # keep the issues after it from closing; stderr is captured to tell a 404
    # from other failures.
    local err
    # shellcheck disable=SC2069
    if ! err="$(gh api "repos/${GITHUB_REPOSITORY}/pulls/${pr}" 2>&1 > "${WORK_DIR}/closed-pr.json")"; then
      if [[ "${err}" == *'(HTTP 404)'* ]]; then
        log "PR #${pr} not found; leaving its issue"
        continue
      fi
      printf '%s\n' "${err}" >&2
      api_error "looking up PR #${pr} failed"
    fi
    case "$(jq --raw-output 'if .state == "open" then "open" elif .merged_at != null then "merged" else "closed" end' \
      "${WORK_DIR}/closed-pr.json")" in
      merged) finish_issue "${issue}" "${pr}" 'merged' 'completed' ;;
      closed) finish_issue "${issue}" "${pr}" 'closed without merging' 'not_planned' ;;
      *) log "PR #${pr} opened after the PR listing; leaving its issue" ;;
    esac
  done
}

# @description Append an outcome line to an issue's body and close it,
#              without a comment.
# @arg $1 issue the issue as `{number, body, ...}` JSON
# @arg $2 pr the PR number, for the log line
# @arg $3 outcome the outcome text
# @arg $4 reason the GitHub `state_reason`, `completed` or `not_planned`
function finish_issue() {
  local -r issue="$1" pr="$2" outcome="$3" reason="$4"
  local issue_number
  issue_number="$(jq --raw-output '.number' <<< "${issue}")"
  jq --compact-output --arg outcome "${outcome}" --arg reason "${reason}" '{
      state: "closed", state_reason: $reason,
      body: ((.body // "" | sub("\\s+$"; "")) + "\n\n**Outcome:** \($outcome)\n")
    }' <<< "${issue}" \
    | gh_api --method PATCH "repos/${GITHUB_REPOSITORY}/issues/${issue_number}" --input - > /dev/null
  log "closed issue #${issue_number} for PR #${pr} (${outcome})"
}

# @description Record a closed PR's outcome in its failure issue and close the
#              issue, if one is open.
# @arg $1 pr the PR number
# @arg $2 merged `true` or `false`, whether the PR was merged
# @exitcode 0 the issue was closed, or none was open
function close_issue() {
  local -r pr="$1" merged="$2"
  local existing
  existing="$(find_issue "${pr}")"
  if [[ -z "${existing}" ]]; then
    log "no open failure issue for PR #${pr}; nothing to do"
    return 0
  fi

  local outcome='closed without merging' reason='not_planned'
  if [[ "${merged}" == 'true' ]]; then
    outcome='merged'
    reason='completed'
  fi
  finish_issue "${existing}" "${pr}" "${outcome}" "${reason}"
}

# @description Handle a closed PR: record the outcome and close its failure
#              issue, if one is open.
# @exitcode 0 the issue was closed, or none was open
function close_cmd() {
  require_env GITHUB_REPOSITORY PR_NUMBER PR_MERGED
  require_format GITHUB_REPOSITORY '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' 'owner/repo'
  require_format PR_NUMBER '^[0-9]+$' 'a number'
  require_format PR_MERGED '^(true|false)$' 'true or false'
  # PR_NUMBER comes from the environment, checked by require_env above.
  # shellcheck disable=SC2153
  close_issue "${PR_NUMBER}" "${PR_MERGED}"
}

function main() {
  local -r subcommand="${1:-}"
  case "${subcommand}" in
    open | close | sweep | problems) ;;
    *) usage_error "unknown subcommand: ${subcommand:-<none>}" ;;
  esac
  if (($# > 1)); then
    usage_error 'too many arguments'
  fi

  WORK_DIR="$(mktemp --directory)"
  readonly WORK_DIR
  trap 'rm --recursive --force -- "${WORK_DIR}"' EXIT

  "${subcommand}_cmd"
}

main "$@"
